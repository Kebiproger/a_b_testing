# ============================================
# A/B Testing Platform — Конфигурация
# Скопируйте в .env и настройте под себя
# ============================================

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=ab_user
POSTGRES_PASSWORD=ab_pass          # смените!
POSTGRES_DB=ab_testing

# --- Admin API Key ---
ADMIN_API_KEY=ab_testing_admin_secret   # смените! Для создания экспериментов

# --- RabbitMQ ---
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# --- ClickHouse ---
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=ab_pass        # смените!

# --- Порты (опционально) ---
# GATEWAY_PORT=8080              # nginx/docker-compose.yml
# COMPANY_APP_PORT=5000          # company_app/docker-compose.yml
# RABBITMQ_MGMT_PORT=15672       # infra/docker-compose.yml (админка)
